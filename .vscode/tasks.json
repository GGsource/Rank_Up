{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Vite Dev Server",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "."
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "VITE",
					"endsPattern": "Local:\\s+https?://"
				}
			}
		}
	]
}